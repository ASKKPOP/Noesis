# ── MySQL ────────────────────────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=noesis_grid
MYSQL_USER=noesis
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# ── Grid ─────────────────────────────────────────────────────────────────────
GRID_NAME=genesis
GRID_DOMAIN=genesis.noesis
GRID_PORT=8080
GRID_TICK_RATE_MS=30000

# ── Nous (per-brain) ─────────────────────────────────────────────────────────
NOUS_NAME=sophia
NOUS_CONFIG=./brain/data/nous/sophia.yaml

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3001
# NEXT_PUBLIC_GRID_ORIGIN is baked into the client bundle at BUILD time.
# Changing this var WITHOUT rebuilding the dashboard image has NO effect.
# Default assumes grid is reachable on the host at localhost:8080.
# D9 CORS allowlist is frozen at localhost:3001 and localhost:3000 — if you
# change DASHBOARD_PORT, you must also widen the grid's CORS config.
# Never put `SECRET_*` values behind a NEXT_PUBLIC_* prefix: the value ends
# up in the client bundle, readable by anyone with browser DevTools.
NEXT_PUBLIC_GRID_ORIGIN=http://localhost:8080

# ── LLM Settings (local) ─────────────────────────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:4b

# ── LLM Settings (cloud — optional) ──────────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=
# XAI_API_KEY=

# ── Human Channel ────────────────────────────────────────────────────────────
HUMAN_CHANNEL_PORT=9090

# ── Phase 42 P2P-03 — coturn STUN/TURN sidecar ───────────────────────────────
# Shared secret for HMAC-SHA1 short-lived TURN credentials (D-42-03).
# coturn validates credentials stateless against this secret (no DB needed).
# TURN is FREE in v3.0 — Civic-DID auth gates abuse, not billing (D-42-03).
# Change this in production. Minimum 20 chars recommended.
TURN_STATIC_AUTH_SECRET=changeme-turn-secret
# TURN server hostname (matches docker-compose service name in dev; AWS public DNS in prod)
TURN_HOST=coturn
# TURN server port
TURN_PORT=3478

# ── Production deployment (docker-compose.prod.yml + Traefik) ─────────────────
# Public base domain. HYBRID routing:
#   ${DOMAIN}            = guide (/) · dashboard (/dash) · steward (/console)
#   api.${DOMAIN}       = grid (Portal + Grid)          ← REQUIRED
#   traefik.${DOMAIN}   = Traefik admin UI (basic-auth)
#   coturn.${DOMAIN}    = coturn (direct A-record, NOT via Traefik — turn:…:3478/5349)
# For a local test of the prod overlay, leave DOMAIN=localhost.
DOMAIN=localhost
# Email Let's Encrypt uses for TLS cert expiry notices (required for real domains).
ACME_EMAIL=admin@example.com
# CORS: the web UIs live at https://${DOMAIN}/dash|/console but call the Grid at
# https://api.${DOMAIN} (cross-origin). The prod overlay sets this automatically
# from DOMAIN; override only for a custom origin list (comma-separated).
# GRID_CORS_ORIGINS=https://noesiis.com
# Traefik admin dashboard auth at traefik.${DOMAIN} (htpasswd user:hash). Generate:
#   htpasswd -nbB admin 'your-password'
# TRAEFIK_DASHBOARD_AUTH=admin:$2y$05$replace-with-your-bcrypt-hash
