# Grid API origin for dashboard fetches. Matches grid/src/main.ts default (8080).
# Override GRID_PORT on the Grid side if you need a different port and update this.
NEXT_PUBLIC_GRID_ORIGIN=http://localhost:8080

# WalletConnect v2 project id (cloud.reown.com) for SIWE "Sign In with Wallet".
# Public, not a secret; baked at build time. Leave unset to disable WalletConnect
# (MetaMask/injected still works) and avoid Reown console errors on portal pages.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
