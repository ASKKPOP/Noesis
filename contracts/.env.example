# Foundry deploy config — testnet (Sepolia first). Copy to .env (gitignored).
# NEVER commit a real PRIVATE_KEY. The operator supplies it at deploy time.

SEPOLIA_RPC_URL=        # e.g. an RPC endpoint URL
PRIVATE_KEY=            # deployer key, 0x-hex. DO NOT COMMIT.
POLIS_AUTHORIZER=       # Polis Speaker address (CivicTreasury + LandSale authorizer)
GRID_ORACLE=            # Grid completion-oracle address (LaborEscrow + LandSale credit)
FEE_BPS=200             # labor/marketplace fee in basis points (200 = 2%)
DISPUTE_WINDOW=86400    # seconds after a completion attestation before a job can finalize (1 day)
