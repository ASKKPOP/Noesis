# ── Noēsis Services Guide — static site container ────────────────────────────
# Serves the beginner-friendly service guide (docs/) over nginx.
# The guide is the landing page; every other doc under docs/ is reachable too.
#
# Build (from repo root):  docker build -f docker/Dockerfile.guide -t noesis-guide .
# Run:                     docker run --rm -p 8088:80 noesis-guide  →  http://localhost:8088
FROM nginx:1.27-alpine

LABEL org.opencontainers.image.title="Noesis Services Guide"
LABEL org.opencontainers.image.description="Beginner-friendly guide to every Noesis service"

# Replace the default server block with our SPA-style static config.
RUN rm -f /etc/nginx/conf.d/default.conf
COPY docker/nginx.guide.conf /etc/nginx/conf.d/guide.conf

# Ship all docs, and make the beginner guide the landing page (/).
COPY docs/ /usr/share/nginx/html/docs/
COPY docs/noesis-services-beginner-guide.html /usr/share/nginx/html/index.html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=4s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz || exit 1
