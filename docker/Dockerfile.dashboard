# syntax=docker/dockerfile:1.7

# ── Stage 0: the world map in Bevy (option C, viz-rs/) → WASM ────────────────
# The orbital map renders with Bevy compiled to WebAssembly; three.js stays as the
# fallback. The bundle (noesis_viz.js + noesis_viz_bg.wasm) lands in
# dashboard/public/viz/ before `next build`.
#   Bundle only:  docker build -f docker/Dockerfile.dashboard --target viz-out -o dashboard/public/viz .
#   Rust tests:   docker build -f docker/Dockerfile.dashboard --target viz-test .
FROM rust:1.100-slim-trixie AS viz-toolchain
# wasm-bindgen-cli MUST equal the wasm-bindgen crate version in viz-rs/Cargo.lock.
ARG WASM_BINDGEN_VERSION=0.2.130
# wasm-opt comes from Debian's binaryen package (trixie: 120).
RUN apt-get update && apt-get install -y --no-install-recommends binaryen && rm -rf /var/lib/apt/lists/* \
 && rustup target add wasm32-unknown-unknown \
 && cargo install wasm-bindgen-cli --version ${WASM_BINDGEN_VERSION} --locked
WORKDIR /viz
COPY viz-rs/Cargo.toml viz-rs/Cargo.lock ./
COPY viz-rs/src ./src
COPY viz-rs/fixtures ./fixtures
COPY viz-rs/tests ./tests

# Native tests: the layout parity fixture (recorded from the TypeScript) and the headless
# scene smoke test (runs the real Bevy systems; catches B0001 conflicts and panics).
FROM viz-toolchain AS viz-test
RUN cargo test --locked

FROM viz-toolchain AS viz
RUN cargo build --release --locked --target wasm32-unknown-unknown --lib \
 && wasm-bindgen --target web --no-typescript --out-dir /out --out-name noesis_viz \
      target/wasm32-unknown-unknown/release/noesis_viz.wasm \
 && wasm-opt -Oz --all-features -o /out/noesis_viz_bg.wasm /out/noesis_viz_bg.wasm

FROM scratch AS viz-out
COPY --from=viz /out/ /

# ── Stage 1: Builder ─────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

# NEXT_PUBLIC_* must be available at BUILD time — Next inlines them into the
# client bundle. Passing via `docker run -e` is too late. See D10 / Pitfall 1.
ARG NEXT_PUBLIC_GRID_ORIGIN=http://localhost:8080
ENV NEXT_PUBLIC_GRID_ORIGIN=${NEXT_PUBLIC_GRID_ORIGIN}
# Apex-path hosting (e.g. "/dash"). Empty in dev → app served at root.
ARG NEXT_PUBLIC_BASE_PATH=
ENV NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH}

# Install native build deps (required by bufferutil / node-gyp)
RUN apk add --no-cache python3 make g++

# Copy workspace manifests first (layer caching)
COPY package.json package-lock.json* ./
COPY dashboard/package.json ./dashboard/

RUN npm ci

# Copy dashboard source
COPY dashboard ./dashboard
# The Bevy world map bundle (Stage 0) — served at /viz/.
COPY --from=viz /out/ ./dashboard/public/viz/

# Build in standalone mode (next.config.mjs → output: 'standalone')
RUN npm run build --workspace=dashboard

# ── Stage 2: Runtime ─────────────────────────────────────────────────────────
FROM node:22-alpine AS runtime

WORKDIR /app

ENV NODE_ENV=production \
    PORT=3001 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Next standalone output (monorepo layout): /app/dashboard/.next/standalone
# contains the self-contained server tree with dashboard/server.js as the entry
# point. Static assets and public files are copied adjacent to the server.
COPY --from=builder --chown=nextjs:nodejs /app/dashboard/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/dashboard/.next/static    ./dashboard/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/dashboard/public          ./dashboard/public

USER nextjs
EXPOSE 3001

# Standalone layout puts the server entrypoint at dashboard/server.js
CMD ["node", "dashboard/server.js"]
