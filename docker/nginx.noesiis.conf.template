# ─────────────────────────────────────────────────────────────────────────────
# Noēsis — nginx reverse proxy (sits BEHIND an AWS Application Load Balancer).
#
#   Route 53 ── HTTPS:443 (ACM cert) ──▶ ALB ── HTTP ──▶ this nginx :80 ──▶ containers
#
# The ALB terminates TLS, so nginx speaks plain HTTP. Routing is by Host header:
#   ${DOMAIN}        → dashboard (/, landing page) · guide (/docs) · wiki (/wiki) · steward (/console)
#   api.${DOMAIN}    → grid (Portal + Grid · REST + WS + Portal)
#   portal.${DOMAIN} → dashboard, the PUBLIC Portal (/ → /portal)
#   system.${DOMAIN} → dashboard, the Tier-3 Portal Manager OPERATOR console (/ → /system/portal-manager)
#
# Rendered from this template by the nginx image entrypoint (envsubst) — only the
# ${DOMAIN} token is substituted (NGINX_ENVSUBST_FILTER=^DOMAIN$); every nginx
# runtime $variable below is preserved.
# ─────────────────────────────────────────────────────────────────────────────

# WebSocket upgrade plumbing (for api.${DOMAIN}/ws/events).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream noesis_guide     { server guide:80; }
upstream noesis_wiki      { server wiki:80; }
upstream noesis_dashboard { server dashboard:3001; }
upstream noesis_steward   { server steward:3002; }
upstream noesis_grid      { server grid:8080; }

# ── Security hardening ───────────────────────────────────────────────────────
# Declared once at http-context so every server/location below inherits it. No
# location defines its own add_header, so nginx's "child add_header replaces
# parent" rule never drops these (revisit if a location ever adds one).
#
#   server_tokens off      — stop leaking the nginx version (Server header).
#   proxy_hide_header      — strip Next.js's X-Powered-By from proxied apps.
#   absolute_redirect off  — keep 302 Location relative (e.g. /wiki → /wiki/)
#                            so the browser stays on https. The ALB terminates
#                            TLS and nginx speaks :80, so an absolute redirect
#                            would otherwise emit http:// and strip TLS.
#   HSTS/nosniff/frame/ref — the `always` flag applies them to error responses
#                            (401/404/…) too, not just 2xx/3xx.
# CSP is intentionally NOT set here — a correct policy for the Next.js apps needs
# app-side testing (inline scripts/styles); see the follow-up note in the PR.
server_tokens off;
absolute_redirect off;
proxy_hide_header X-Powered-By;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header X-Content-Type-Options    "nosniff"                            always;
add_header X-Frame-Options           "SAMEORIGIN"                         always;
add_header Referrer-Policy           "strict-origin-when-cross-origin"    always;

# ── Apex: dashboard (/) + guide docs (/docs) + steward (/console) ────────────
server {
    listen 80;
    server_name ${DOMAIN};

    # ALB already terminated TLS — tell upstreams the original scheme.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    # Dashboard owns the apex (no basePath); steward keeps basePath=/console so
    # its prefix passes through unchanged (no rewrite). Static docs (the services
    # guide et al.) stay reachable under /docs/ via the guide container.
    location /docs/   { proxy_pass http://noesis_guide; }
    location = /docs  { return 302 /docs/noesis-services-beginner-guide.html; }
    # Wiki (single source of truth — MkDocs static site) under /wiki/.
    location /wiki/   { proxy_pass http://noesis_wiki; }
    location = /wiki  { return 302 /wiki/; }
    # Full spec doc set — static files mounted read-only from the repo's docs/spec.
    location = /spec  { return 302 /spec/; }
    location /spec/   { alias /usr/share/nginx/spec/; index index.html; autoindex off; }
    # Short shareable link → the 3-developer QA testing guide (served in place, no redirect).
    location = /qa    { alias /usr/share/nginx/spec/qa-testing-guide.html; default_type text/html; }
    location /console { proxy_pass http://noesis_steward; }
    location /        { proxy_pass http://noesis_dashboard; }
}

# ── api subdomain → grid (REST + WebSocket firehose + Portal) ────────────────
server {
    listen 80;
    server_name api.${DOMAIN};

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    # WebSocket upgrade for /ws/events (and any future WS routes).
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;   # keep the firehose alive

    location / { proxy_pass http://noesis_grid; }
}

# ── portal subdomain → the PUBLIC Portal (the user-facing meta-layer) ─────────
# portal.${DOMAIN} is the Portal users meet: sign in, browse Grids, apply, join
# communities, marketplace, library. Today that experience is the dashboard's
# /portal/* pages (Grid-hosted); when the standalone Portal service (Phase 52)
# ships, this same domain re-points to it — no user-facing URL churn.
server {
    listen 80;
    server_name portal.${DOMAIN};

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    # Relative redirect keeps the browser on https (nginx speaks http behind the ALB).
    absolute_redirect off;
    location = / { return 302 /portal; }
    location /   { proxy_pass http://noesis_dashboard; }
}

# ── system subdomain → the Tier-3 Portal Manager OPERATOR console ─────────────
# system.${DOMAIN} is the Henry-side meta-ops console (read-only monitoring:
# reviewer queue + DID-issuance tracker + audit-chain viewer). Still gated
# server-side: GRID_PORTAL_MANAGER_ENABLED + a Portal session (operatorScope) on
# the grid — this subdomain is convenience, not authority. Also reachable at
# ${DOMAIN}/system/portal-manager.
server {
    listen 80;
    server_name system.${DOMAIN};

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    absolute_redirect off;
    location = / { return 302 /system/portal-manager; }
    location /   { proxy_pass http://noesis_dashboard; }
}
