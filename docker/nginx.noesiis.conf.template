# ─────────────────────────────────────────────────────────────────────────────
# Noēsis — nginx reverse proxy (sits BEHIND an AWS Application Load Balancer).
#
#   Route 53 ── HTTPS:443 (ACM cert) ──▶ ALB ── HTTP ──▶ this nginx :80 ──▶ containers
#
# The ALB terminates TLS, so nginx speaks plain HTTP. Routing is by Host header:
#   ${DOMAIN}        → dashboard (/, landing page) · guide (/docs) · wiki (/wiki) · steward (/console)
#   api.${DOMAIN}    → grid (Portal + Grid · REST + WS + Portal)
#   portal.${DOMAIN} → dashboard (Tier-3 Portal Manager console; / → /system/portal-manager)
#
# Rendered from this template by the nginx image entrypoint (envsubst) — only the
# ${DOMAIN} token is substituted (NGINX_ENVSUBST_FILTER=^DOMAIN$); every nginx
# runtime $variable below is preserved.
# ─────────────────────────────────────────────────────────────────────────────

# WebSocket upgrade plumbing (for api.${DOMAIN}/ws/events).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream noesis_guide     { server guide:80; }
upstream noesis_wiki      { server wiki:80; }
upstream noesis_dashboard { server dashboard:3001; }
upstream noesis_steward   { server steward:3002; }
upstream noesis_grid      { server grid:8080; }

# ── Apex: dashboard (/) + guide docs (/docs) + steward (/console) ────────────
server {
    listen 80;
    server_name ${DOMAIN};

    # ALB already terminated TLS — tell upstreams the original scheme.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    # Dashboard owns the apex (no basePath); steward keeps basePath=/console so
    # its prefix passes through unchanged (no rewrite). Static docs (the services
    # guide et al.) stay reachable under /docs/ via the guide container.
    location /docs/   { proxy_pass http://noesis_guide; }
    location = /docs  { return 302 /docs/noesis-services-beginner-guide.html; }
    # Wiki (single source of truth — MkDocs static site) under /wiki/.
    location /wiki/   { proxy_pass http://noesis_wiki; }
    location = /wiki  { return 302 /wiki/; }
    # Full spec doc set — static files mounted read-only from the repo's docs/spec.
    location = /spec  { return 302 /spec/; }
    location /spec/   { alias /usr/share/nginx/spec/; index index.html; autoindex off; }
    location /console { proxy_pass http://noesis_steward; }
    location /        { proxy_pass http://noesis_dashboard; }
}

# ── api subdomain → grid (REST + WebSocket firehose + Portal) ────────────────
server {
    listen 80;
    server_name api.${DOMAIN};

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    # WebSocket upgrade for /ws/events (and any future WS routes).
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 3600s;   # keep the firehose alive

    location / { proxy_pass http://noesis_grid; }
}

# ── portal subdomain → dashboard (Tier-3 Portal Manager console) ─────────────
# Serves the same dashboard container; the bare host lands operators on the
# read-only Portal Manager console (/system/portal-manager). The console is
# still gated server-side: GRID_PORTAL_MANAGER_ENABLED + a Portal session
# (operatorScope) on the grid — this subdomain is convenience, not authority.
server {
    listen 80;
    server_name portal.${DOMAIN};

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_http_version 1.1;

    # Issue a RELATIVE Location so the browser keeps the original https scheme
    # (nginx speaks http behind the ALB; an absolute redirect would downgrade to
    # http and break the console's secure cookie + credentialed CORS).
    absolute_redirect off;
    location = / { return 302 /system/portal-manager; }
    location /   { proxy_pass http://noesis_dashboard; }
}
