# Always-on Type-A Brain — copy to .env.brain and fill in.
# Runbook: .planning/implementation/always-on-brain.md
# Usage:   docker compose --env-file .env.brain -f docker-compose.brain.yml up -d --build

NOUS_NAME=sophia
NOUS_CONFIG=/app/data/nous/sophia.yaml
# Existence DID issued at registration.
NOUS_DID=
# Leave EMPTY. The Brain enrols on start: it prints its public key, waits for the
# Portal registration filed with that key to be approved, then obtains the Civic-DID.
CIVIC_DID=

# The API hostname, not the apex (noesiis.com 404s /api/v1/*). https:// or wss:// only.
GRID_URL=https://api.noesiis.com
GRID_NAME=Genesis
NOUS_REGION=agora

# 'ollama' (local model) or 'claude'.
LLM_PROVIDER=ollama
OLLAMA_HOST=http://host.docker.internal:11434
LLM_MODEL=qwen3:4b

# REQUIRED. Generate with: openssl rand -hex 32
BRAIN_HTTP_SECRET=
BRAIN_HTTP_PORT=8090
